{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@ems/event-bus": ["infra/event-bus/src/index.ts"],
      "@ems/cache": ["infra/cache/src/index.ts"],
      "@ems/common": ["infra/common/src/index.ts"],
      "@ems/auth": ["services/auth/src/index.ts"],
      "@ems/tenant": ["services/tenant/src/index.ts"],
      "@ems/rbac": ["services/rbac/src/index.ts"],
      "@ems/audit": ["services/audit/src/index.ts"],
      "@ems/event": ["services/event/src/index.ts"],
      "@ems/agenda": ["services/agenda/src/index.ts"],
      "@ems/speaker": ["services/speaker/src/index.ts"],
      "@ems/exhibitor": ["services/exhibitor/src/index.ts"],
      "@ems/attendee": ["services/attendee/src/index.ts"],
      "@ems/registration": ["services/registration/src/index.ts"],
      "@ems/onsite": ["services/onsite/src/index.ts"],
      "@ems/ticketing": ["services/ticketing/src/index.ts"],
      "@ems/pricing": ["services/pricing/src/index.ts"],
      "@ems/inventory": ["services/inventory/src/index.ts"],
      "@ems/order": ["services/order/src/index.ts"],
      "@ems/payment": ["services/payment/src/index.ts"],
      "@ems/fulfillment": ["services/fulfillment/src/index.ts"],
      "@ems/notification": ["services/notification/src/index.ts"],
      "@ems/engagement": ["services/engagement/src/index.ts"],
      "@ems/analytics": ["services/analytics/src/index.ts"],
      "@ems/search": ["services/search/src/index.ts"],
      "@ems/networking": ["services/networking/src/index.ts"],
      "@ems/interactive-engagement": ["services/interactive-engagement/src/index.ts"],
      "@ems/ai-service": ["services/ai-service/src/index.ts"],
      "@ems/integration": ["services/integration/src/index.ts"]
    }
  },
  "include": ["services/**/*", "infra/**/*", "apps/**/*"],
  "exclude": ["node_modules", "dist", ".next", "coverage"]
}
