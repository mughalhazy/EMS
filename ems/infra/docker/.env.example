# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=ems
POSTGRES_PASSWORD=ems_secret
POSTGRES_DB=ems
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ems:ems_secret@localhost:5432/ems

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=ems_redis_secret
REDIS_PORT=6379
REDIS_URL=redis://:ems_redis_secret@localhost:6379

# ── Kafka ─────────────────────────────────────────────────────────────────
KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_BROKERS=localhost:9092
KAFKA_UI_PORT=8080

# ── OpenSearch ────────────────────────────────────────────────────────────
OPENSEARCH_PORT=9200
OPENSEARCH_PASSWORD=Ems_Search_S3cret!
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_DASHBOARDS_PORT=5601

# ── MinIO ─────────────────────────────────────────────────────────────────
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=ems_minio
MINIO_ROOT_PASSWORD=ems_minio_secret
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=ems_minio
MINIO_SECRET_KEY=ems_minio_secret

# ── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
JWT_SECRET=change_me_in_production_use_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
