# Staging environment template.
#
# Values wrapped as `${SECRET:<name>}` are NOT real values — they are
# placeholders resolved by the deployment platform's secrets integration
# (see infra/deployment/secrets/README.md) before the container starts.
# Everything else is non-sensitive configuration that can live in plain
# environment variables / a ConfigMap.

NODE_ENV=staging
APP_PORT=3000
CORS_ORIGINS=https://staging.app.example.com

# ── PostgreSQL (managed instance) ───────────────────────────────────────
DATABASE_URL=${SECRET:ems/staging/database_url}

# ── Redis (managed instance) ────────────────────────────────────────────
REDIS_HOST=ems-redis.staging.internal
REDIS_PORT=6379
REDIS_PASSWORD=${SECRET:ems/staging/redis_password}

# ── Kafka ────────────────────────────────────────────────────────────────
KAFKA_BROKERS=ems-kafka-0.staging.internal:9092,ems-kafka-1.staging.internal:9092

# ── OpenSearch (provisioned; not yet used by the API — search currently
#    runs against Postgres ILIKE, see docs/canon) ─────────────────────────
OPENSEARCH_URL=https://ems-opensearch.staging.internal:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=${SECRET:ems/staging/opensearch_password}

# ── Object storage (S3-compatible; provisioned, not yet used by the API) ─
MINIO_ENDPOINT=https://ems-objects.staging.internal
MINIO_ACCESS_KEY=${SECRET:ems/staging/object_storage_access_key}
MINIO_SECRET_KEY=${SECRET:ems/staging/object_storage_secret_key}

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=${SECRET:ems/staging/jwt_secret}
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Notifications (email) ───────────────────────────────────────────────
SMTP_HOST=ems-smtp.staging.internal
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=${SECRET:ems/staging/smtp_user}
SMTP_PASSWORD=${SECRET:ems/staging/smtp_password}
SMTP_FROM=no-reply@staging.app.example.com
