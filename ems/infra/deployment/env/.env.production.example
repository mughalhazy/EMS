# Production environment template.
#
# Values wrapped as `${SECRET:<name>}` are NOT real values — they are
# placeholders resolved by the deployment platform's secrets integration
# (see infra/deployment/secrets/README.md) before the container starts.
# Everything else is non-sensitive configuration that can live in plain
# environment variables / a ConfigMap.
#
# Differences from staging: stricter CORS, longer-lived infra hostnames,
# refresh tokens issued for a shorter window.

NODE_ENV=production
APP_PORT=3000
CORS_ORIGINS=https://app.example.com

# ── PostgreSQL (managed instance, read replica aware) ───────────────────
DATABASE_URL=${SECRET:ems/production/database_url}

# ── Redis (managed instance) ────────────────────────────────────────────
REDIS_HOST=ems-redis.production.internal
REDIS_PORT=6379
REDIS_PASSWORD=${SECRET:ems/production/redis_password}

# ── Kafka ────────────────────────────────────────────────────────────────
KAFKA_BROKERS=ems-kafka-0.production.internal:9092,ems-kafka-1.production.internal:9092,ems-kafka-2.production.internal:9092

# ── OpenSearch (provisioned; not yet used by the API — search currently
#    runs against Postgres ILIKE, see docs/canon) ─────────────────────────
OPENSEARCH_URL=https://ems-opensearch.production.internal:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=${SECRET:ems/production/opensearch_password}

# ── Object storage (S3-compatible; provisioned, not yet used by the API) ─
MINIO_ENDPOINT=https://ems-objects.production.internal
MINIO_ACCESS_KEY=${SECRET:ems/production/object_storage_access_key}
MINIO_SECRET_KEY=${SECRET:ems/production/object_storage_secret_key}

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=${SECRET:ems/production/jwt_secret}
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1d

# ── Notifications (email) ───────────────────────────────────────────────
SMTP_HOST=ems-smtp.production.internal
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=${SECRET:ems/production/smtp_user}
SMTP_PASSWORD=${SECRET:ems/production/smtp_password}
SMTP_FROM=no-reply@app.example.com
